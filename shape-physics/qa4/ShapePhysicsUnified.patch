+Bool Function TryEvaluateLiveGT(Actor target, ArmorAddon addon, string current, string path, int sample, int group, float index)
+    string family = GTLiveFamily(current)
+    if family == "" || family != GTLiveFamily(path)
+        return false
+    endif
+
+    string accepted = ShapePhysicsLive.GetTargetGT(target, addon)
+    if current == path && accepted == ""
+        return false
+    endif
+
+    accepted = AdvanceGTLiveTarget(target, addon, current, path, accepted, "body")
+    string status = "$S3BA_GT"
+    if accepted == path
+        rejectedGTLiveTarget = ""
+    else
+        status = "GT SMP QA (target rejected)"
+        if rejectedGTLiveTarget != path
+            rejectedGTLiveTarget = path
+            Debug.Trace("[ShapePhysicsLiveGTQA] body target rejected=" + path + " base=" + current)
+        endif
+    endif
+
+    playerGTLiveTarget = accepted
+    UpdateGTAuxiliary(target, sample, true)
+    MarkRegionalProfile(target, true)
+    ReportActor(target, status, current, GroupLabel(group), index)
+    return true
+EndFunction
+
+String Function AdvanceGTLiveTarget(Actor target, ArmorAddon addon, string current, string path, string accepted, string instanceName)
+    if accepted != path && (current != path || accepted != "")
+        if ShapePhysicsLive.BlendGT(target, addon, path, 0.5)
+            Debug.Trace("[ShapePhysicsLiveGTQA] " + instanceName + " target=" + path + " base=" + current)
+            return path
+        endif
+    endif
+    return accepted
+EndFunction
+
+String Function GTLiveFamily(string path)
+    string prefix = "SKSE\\Plugins\\hdtSkinnedMeshConfigs\\ShapePhysicsRegional\\"
+    if StringUtil.Find(path, prefix) != 0
+        return ""
+    endif
+    int prefixLength = StringUtil.GetLength(prefix)
+    int nameEnd = StringUtil.Find(path, "__", prefixLength)
+    if nameEnd <= prefixLength
+        return ""
+    endif
+    string template = StringUtil.Substring(path, prefixLength, nameEnd - prefixLength)
+    if template == "gt_small"
+        if StringUtil.Find(path, "__gt-growth1_gt_medium_gt_large_") < 0
+            return ""
+        endif
+    elseif template == "gt_slot60" || template == "gt_slot60_extended"
+        if StringUtil.Find(path, "__gt-regional4") < 0 || StringUtil.Find(path, "_r4_") < 0
+            return ""
+        endif
+    else
+        return ""
+    endif
+    int stampStart = nameEnd + 2
+    int stampEnd = StringUtil.Find(path, "__", stampStart)
+    if stampEnd != stampStart + 12
+        return ""
+    endif
+    return StringUtil.Substring(path, 0, stampEnd)
 EndFunction
 
