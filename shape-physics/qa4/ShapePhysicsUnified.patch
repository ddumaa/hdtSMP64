+Function RegisterOBodyRefresh()
+    if hasOBody
+        RegisterForModEvent("Obody_ApplyMorph", "OnOBodyMorphApplied")
+    else
+        UnregisterForModEvent("Obody_ApplyMorph")
+    endif
+EndFunction
+
+Event OnOBodyMorphApplied(string eventName, string strArg, float numArg, Form sender)
+    Actor target = sender as Actor
+    if strArg != "ApplyMorphs" || !target || !RuntimeDependenciesReady() || !IsEnabled()
+        return
+    endif
+    if target != Game.GetPlayer() && !adaptNPCs
+        return
+    endif
+
+    StorageUtil.FormListAdd(self, oBodyRefreshQueue, target, false)
+    if oBodyRefreshScheduled
+        return
+    endif
+    oBodyRefreshScheduled = true
+    ; Wait in game time so the picker can close and OBody can finish its equipment refresh.
+    Utility.Wait(0.15)
+    oBodyRefreshScheduled = false
+    if !updateRunning && !Utility.IsInMenuMode()
+        updateRunning = true
+        RefreshOBodyActors(Game.GetPlayer())
+        updateRunning = false
+    endif
+EndEvent
+
+Function RefreshOBodyActors(Actor player)
+    int remaining = StorageUtil.FormListCount(self, oBodyRefreshQueue)
+    while remaining > 0 && !oBodyRefreshScheduled
+        Actor target = StorageUtil.FormListGet(self, oBodyRefreshQueue, 0) as Actor
+        StorageUtil.FormListRemoveAt(self, oBodyRefreshQueue, 0)
+        if target && IsEnabled() && target.Is3DLoaded() && !target.IsDead()
+            if target == player
+                Debug.Trace("[ShapePhysicsUnified] OBody morph refresh for player")
+                EvaluateActor(target)
+            elseif adaptNPCs && ((sceneActors && sceneActors.Find(target) >= 0) \
+                || (HasNPCScanner() && target.GetDistance(player) <= 1400.0))
+                EvaluateActor(target)
+            endif
+        endif
+        remaining -= 1
+    endwhile
+EndFunction
