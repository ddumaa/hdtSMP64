+Bool Function TryEvaluateLive3BA(Actor target, ArmorAddon addon, string current, string expected, int group, float index)
+    string family = ThreeBALiveFamily(current)
+    if family == "" || family != ThreeBALiveFamily(expected)
+        return false
+    endif
+
+    string accepted = ShapePhysicsLive.GetTarget3BA(target, addon)
+    if current == expected && accepted == ""
+        return false
+    endif
+    if accepted != expected && ShapePhysicsLive.Blend3BA(target, addon, expected, 0.5)
+        accepted = expected
+        Debug.Trace("[ShapePhysicsLive3BAQA] body target=" + expected + " base=" + current)
+    endif
+
+    string status = "$S3BA_SMP"
+    if accepted == expected
+        rejected3BALiveTarget = ""
+    else
+        status = "3BA SMP QA (target rejected)"
+        if rejected3BALiveTarget != expected
+            rejected3BALiveTarget = expected
+            Debug.Trace("[ShapePhysicsLive3BAQA] body target rejected=" + expected + " base=" + current)
+        endif
+    endif
+    player3BALiveTarget = accepted
+    MarkRegionalProfile(target, true)
+    ReportActor(target, status, current, ReportedGroup(group), index)
+    return true
+EndFunction
+
+String Function ThreeBALiveFamily(string path)
+    string prefix = "SKSE\\Plugins\\hdtSkinnedMeshConfigs\\ShapePhysicsRegional\\threeba_"
+    if StringUtil.Find(path, prefix) != 0
+        return ""
+    endif
+    int nameEnd = StringUtil.Find(path, "__", StringUtil.GetLength(prefix))
+    if nameEnd < 0
+        return ""
+    endif
+    int stampEnd = StringUtil.Find(path, "__", nameEnd + 2)
+    if stampEnd != nameEnd + 14 || StringUtil.Find(path, "__3ba-smooth_q", stampEnd) != stampEnd
+        return ""
+    endif
+    return StringUtil.Substring(path, 0, stampEnd)
 EndFunction
 
